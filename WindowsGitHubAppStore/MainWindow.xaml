<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitHub Store" Height="860" Width="1500" Background="#F3F3F3"><Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#0067C0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D1D5DB"/></Style><Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></Window.Resources><DockPanel><StatusBar DockPanel.Dock="Bottom" Background="White" Foreground="#374151"><TextBlock Text="{Binding StatusText}"/></StatusBar><Border DockPanel.Dock="Left" Width="220" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"><StackPanel Margin="14"><TextBlock Text="GitHub Store" Foreground="#111827" FontSize="25" FontWeight="Bold" Margin="0,10,0,22"/><Button Content="Home" Command="{Binding CategoryCommand}" CommandParameter="windows app"/><Button Content="AI" Command="{Binding CategoryCommand}" CommandParameter="artificial intelligence app"/><Button Content="Games" Command="{Binding CategoryCommand}" CommandParameter="game engine windows"/><Button Content="Editors" Command="{Binding CategoryCommand}" CommandParameter="text editor app"/><Button Content="Browsers" Command="{Binding CategoryCommand}" CommandParameter="web browser app"/><Button Content="Terminals" Command="{Binding CategoryCommand}" CommandParameter="terminal emulator"/><Button Content="Developer Tools" Command="{Binding CategoryCommand}" CommandParameter="developer tool"/><Separator Margin="0,18"/><TextBlock Text="Account" Foreground="#6B7280" FontWeight="Bold"/><TextBox Text="{Binding TokenText}" ToolTip="GitHub token"/><Button Content="Save Token" Command="{Binding SaveTokenCommand}"/><Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}"/><Button Content="Installed Apps" Command="{Binding LoadInstalledCommand}"/></StackPanel></Border><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.ColumnSpan="2" Background="#DDEEFF" CornerRadius="18" Padding="24" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Discover Windows apps from GitHub" Foreground="#111827" FontSize="36" FontWeight="Bold"/><TextBlock Text="Search open-source apps, download releases, install packages, and track updates in one clean store." Foreground="#374151" FontSize="16" Margin="0,8,0,18"/><StackPanel Orientation="Horizontal"><TextBox Width="620" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="★" Foreground="#0067C0" FontSize="96" VerticalAlignment="Center" Margin="20,0,20,0"/></Grid></Border><StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Text="Featured apps" Foreground="#111827" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding FeaturedApps}" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="300" Height="160" Background="White" CornerRadius="16" Padding="14" Margin="0,0,12,0" BorderBrush="#E5E7EB" BorderThickness="1"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="{Binding Owner.AvatarUrl}" Width="44" Height="44"/><StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#111827"/><TextBlock Text="{Binding Owner.Login}" Foreground="#6B7280"/></StackPanel></StackPanel><TextBlock Text="{Binding Description}" Foreground="#4B5563" TextWrapping="Wrap" Height="44" Margin="0,10,0,6"/><Button Content="Get" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Apps" Foreground="#111827" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Repositories}"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,10,12" BorderBrush="#E5E7EB" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Image Source="{Binding Owner.AvatarUrl}" Width="64" Height="64"/><StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="{Binding FullName}" Foreground="#111827" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#4B5563" TextWrapping="Wrap"/><Border Height="82" CornerRadius="10" Margin="0,10,0,8" Background="#EEF2FF"><Image Source="{Binding ScreenshotUrl}" Stretch="UniformToFill"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="Language " Foreground="#6B7280"/><TextBlock Text="{Binding Language}" FontWeight="Bold" Margin="0,0,18,0"/><TextBlock Text="★ " Foreground="#6B7280"/><TextBlock Text="{Binding Stars}" FontWeight="Bold" Margin="0,0,18,0"/><TextBlock Text="Forks " Foreground="#6B7280"/><TextBlock Text="{Binding Forks}" FontWeight="Bold"/></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Get" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Download" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Copy Clone" Command="{Binding DataContext.CopyCloneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><Border Grid.Row="2" Grid.Column="1" Background="White" CornerRadius="16" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1"><StackPanel><TextBlock Text="Installed apps" Foreground="#111827" FontSize="22" FontWeight="Bold"/><TextBlock Text="Your local app library" Foreground="#6B7280" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding InstalledApps}"><ListBox.ItemTemplate><DataTemplate><Border Background="#F9FAFB" CornerRadius="12" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding FullName}" Foreground="#111827" FontWeight="Bold"/><TextBlock Text="{Binding Version}" Foreground="#0067C0"/><TextBlock Text="{Binding InstallPath}" Foreground="#6B7280" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><Border Background="White" CornerRadius="10" Padding="18,8" Margin="8"><TextBlock Text="{Binding CurrentPage}" Foreground="#111827" FontSize="18" FontWeight="Bold"/></Border><Button Content="Next" Command="{Binding NextPageCommand}"/></StackPanel></Grid></DockPanel></Window>