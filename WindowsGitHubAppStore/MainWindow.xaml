<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows GitHub App Store" Height="700" Width="1200"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="400" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/></StackPanel><ListBox ItemsSource="{Binding Repositories}" DisplayMemberPath="FullName"/></DockPanel></Window>