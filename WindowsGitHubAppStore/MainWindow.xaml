<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows GitHub App Store" Height="800" Width="1400"><DockPanel><StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding StatusText}"/></StatusBar><StackPanel DockPanel.Dock="Left" Width="140"><Button Content="AI" Command="{Binding CategoryCommand}" CommandParameter="artificial intelligence"/><Button Content="Games" Command="{Binding CategoryCommand}" CommandParameter="game engine"/><Button Content="Editors" Command="{Binding CategoryCommand}" CommandParameter="text editor"/><Button Content="Browsers" Command="{Binding CategoryCommand}" CommandParameter="web browser"/></StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox Width="450" Text="{Binding SearchText}"/><Button Content="Search" Command="{Binding SearchCommand}"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Repositories}" DisplayMemberPath="FullName"/></Grid></DockPanel></Window>