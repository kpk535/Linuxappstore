<Window x:Class="WindowsGitHubAppStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub App Store"
        Height="900" Width="1440" MinHeight="700" MinWidth="1100"
        Background="{DynamicResource StoreBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Main layout (sidebar + content) ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource StoreSidebarBg}"
                    BorderBrush="{DynamicResource StoreBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,12">
                        <TextBlock Text="GitHub Store"
                                   Foreground="{DynamicResource StoreText}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Open-source app catalog"
                                   Foreground="{DynamicResource StoreSubText}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Nav items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0">

                            <!-- Home -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Home" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" FontSize="15" Width="22"/>
                                    <TextBlock Text="Home" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Library -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Library" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" FontSize="13" Width="22"/>
                                    <TextBlock Text="Library" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Updates with badge -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Updates" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdatesPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↑" FontSize="15" Width="22"/>
                                        <TextBlock Text="Updates" FontSize="14"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource UpdateBadge}"
                                            Visibility="{Binding HasPendingUpdates, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding UpdateCountText}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="WINDOWS SYSTEM" Foreground="{DynamicResource StoreSubText}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,6"/>

                            <!-- Windows Apps (registry) -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="WindowsApps" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowsAppsPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥" FontSize="13" Width="22"/>
                                    <TextBlock Text="Windows Apps" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Startup Manager -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Startup" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartupPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="13" Width="22"/>
                                    <TextBlock Text="Startup" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- System Cleaner -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Cleaner" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCleanerPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✦" FontSize="14" Width="22"/>
                                    <TextBlock Text="Cleaner" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Winget Package Manager -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Winget" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWingetPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="13" Width="22"/>
                                    <TextBlock Text="Winget" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Process Manager -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Processes" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProcessPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="13" Width="22"/>
                                    <TextBlock Text="Processes" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Environment Variables -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="EnvVars" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnvVarsPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" FontSize="13" Width="22"/>
                                    <TextBlock Text="Env Vars" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="ACCOUNT" Foreground="{DynamicResource StoreSubText}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,6"/>

                            <!-- Profile -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Profile" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfilePage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="13" Width="22"/>
                                    <TextBlock Text="Profile" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="13" Width="22"/>
                                    <TextBlock Text="Settings" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- System Info -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="SysInfo" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSysInfoPage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ" FontSize="13" Width="22"/>
                                    <TextBlock Text="System Info" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="BROWSE" Foreground="{DynamicResource StoreSubText}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,6"/>

                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="AI machine learning app">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🤖" FontSize="13" Width="22"/>
                                    <TextBlock Text="AI &amp; ML" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="game windows app">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮" FontSize="13" Width="22"/>
                                    <TextBlock Text="Games" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="text editor IDE">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✏" FontSize="13" Width="22"/>
                                    <TextBlock Text="Editors" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="web browser chromium">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="13" Width="22"/>
                                    <TextBlock Text="Browsers" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="terminal emulator windows">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" FontSize="12" Width="22"/>
                                    <TextBlock Text="Terminals" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="developer tool CLI windows">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" FontSize="13" Width="22"/>
                                    <TextBlock Text="Dev Tools" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Command="{Binding CategoryCommand}" CommandParameter="multimedia video audio windows">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎵" FontSize="13" Width="22"/>
                                    <TextBlock Text="Media" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mini profile + theme toggle at sidebar bottom -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,14">
                        <Separator Margin="0,0,0,8"/>
                        <!-- Mini profile card — click navigates to Profile -->
                        <Border Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}"
                                BorderThickness="1" CornerRadius="12" Padding="10,9"
                                Margin="0,0,0,6" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateCommand}"
                                              CommandParameter="Profile"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource AvatarCircle}"
                                        Width="32" Height="32" Margin="0,0,9,0">
                                    <TextBlock Text="{Binding Profile.Initials}"
                                               Foreground="{DynamicResource StoreAccent}"
                                               FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Profile.DisplayName}"
                                               Foreground="{DynamicResource StoreText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{DynamicResource StoreSubText}" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Windows User"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Profile.HasGitHubProfile}" Value="True">
                                                        <Setter Property="Text" Value="GitHub Connected"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Theme toggle -->
                        <Button Command="{Binding ToggleThemeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="14" Width="22">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☀"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Text" Value="🌙"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Light Mode"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Text" Value="Dark Mode"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ CONTENT AREA ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar with search -->
                <Border Grid.Row="0"
                        Background="{DynamicResource StoreSurface}"
                        BorderBrush="{DynamicResource StoreBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Search"
                                    Command="{Binding SearchCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="⟳ Loading…"
                                   Foreground="{DynamicResource StoreAccent}"
                                   FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Pages container -->
                <Grid Grid.Row="1" Background="{DynamicResource StoreBackground}">

                    <!-- ══════════════════════════════════════════════════════
                         HOME PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <ScrollViewer Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}"
                                  Padding="24,20,24,20">
                        <StackPanel>
                            <!-- Login banner: shown when no GitHub token is configured -->
                            <Border Background="{DynamicResource StoreAccentLight}"
                                    BorderBrush="{DynamicResource StoreAccent}"
                                    BorderThickness="1" CornerRadius="12" Padding="18,14"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding ShowLoginBanner, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Connect your GitHub account"
                                                   Foreground="{DynamicResource StoreAccent}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Add a Personal Access Token for higher API rate limits, GitHub profile data, and private repo access."
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Connect GitHub"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="Settings"
                                                Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="Padding" Value="14,8"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Skip"
                                                Command="{Binding DismissLoginBannerCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Padding" Value="14,8"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource HeroCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="{DynamicResource StoreAccent}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="OPEN SOURCE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="Windows app catalog powered by GitHub"
                                                       Foreground="{DynamicResource StoreAccent}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Discover apps from GitHub"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Search open-source Windows apps, download releases, install packages, and track updates — all in one place."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="14" Margin="0,8,0,18" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Browse Apps"
                                                    Command="{Binding SearchCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Padding" Value="20,10"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="My Library"
                                                    Command="{Binding NavigateCommand}"
                                                    CommandParameter="Library"
                                                    Margin="8,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="20,10"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Decorative right column -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                                        <TextBlock Text="⊞" Foreground="{DynamicResource StoreAccent}"
                                                   FontSize="72" Opacity="0.15" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-8,0,0">
                                            <TextBlock Text="★ " Foreground="{DynamicResource StoreWarning}" FontSize="12"/>
                                            <TextBlock Text="5M+ repos" Foreground="{DynamicResource StoreSubText}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Featured" Style="{StaticResource SectionHeader}"/>
                            <ListBox ItemsSource="{Binding FeaturedApps}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Margin="0,0,0,20">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FeatureCard}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Width="38" Height="38" CornerRadius="8"
                                                            Background="{DynamicResource StoreSoftAccent}">
                                                        <Image Source="{Binding Owner.AvatarUrl}"
                                                               Width="34" Height="34"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource StoreText}"/>
                                                        <TextBlock Text="{Binding Owner.Login}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource StoreSubText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource StoreSubText}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           MaxHeight="42" Margin="0,0,0,10"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="★ " Foreground="{DynamicResource StoreWarning}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Stars, StringFormat={}{0:N0}}"
                                                               Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Content="Get"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="Padding" Value="14,6"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Results" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="◄" Command="{Binding PreviousPageCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Padding" Value="10,6"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Background="{DynamicResource StoreSurface}"
                                            BorderBrush="{DynamicResource StoreBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="4,0">
                                        <TextBlock Text="{Binding SearchPage}"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <Button Content="►" Command="{Binding NextPageCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Padding" Value="10,6"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding Repositories}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StoreCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="48" Height="48" CornerRadius="10"
                                                        Background="{DynamicResource StoreSoftAccent}"
                                                        VerticalAlignment="Top">
                                                    <Image Source="{Binding Owner.AvatarUrl}" Width="44" Height="44"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                                    <TextBlock Text="{Binding FullName}"
                                                               Foreground="{DynamicResource StoreText}"
                                                               FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{DynamicResource StoreSubText}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               Margin="0,3,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                BorderBrush="{DynamicResource StoreBorder}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Language}"
                                                                       Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                BorderBrush="{DynamicResource StoreBorder}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="★ " Foreground="{DynamicResource StoreWarning}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Stars, StringFormat={}{0:N0}}"
                                                                           Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                BorderBrush="{DynamicResource StoreBorder}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⑂ " Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Forks, StringFormat={}{0:N0}}"
                                                                           Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                                                    <Button Content="Get"
                                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Details"
                                                            Style="{StaticResource GhostButton}"
                                                            Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="GitHub"
                                                            Style="{StaticResource GhostButton}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════════════════════════════════════════
                         LIBRARY PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Library" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Foreground="{DynamicResource StoreSubText}" FontSize="13">
                                        <TextBlock.Text>
                                            <Binding Path="InstalledApps.Count" StringFormat="{}{0} installed app(s)"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                            Command="{Binding LoadInstalledCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoInstalledApps, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No apps installed yet"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Search for apps on the Home page and click Get to add them here."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding InstalledApps}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="10"
                                                            Background="{DynamicResource StoreSoftAccent}"
                                                            VerticalAlignment="Top">
                                                        <Image Source="{Binding AvatarUrl}" Width="40" Height="40"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FullName}"
                                                                       Foreground="{DynamicResource StoreText}"
                                                                       FontSize="15" FontWeight="Bold"/>
                                                            <Border Background="{DynamicResource StoreWarningLight}"
                                                                    BorderBrush="{DynamicResource StoreWarning}"
                                                                    BorderThickness="1" CornerRadius="8"
                                                                    Padding="8,2" Margin="10,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Update available"
                                                                           Foreground="{DynamicResource StoreWarning}"
                                                                           FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="v" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Version}"
                                                                               Foreground="{DynamicResource StoreAccent}"
                                                                               FontSize="11" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                                <TextBlock Text="{Binding InstalledAt, StringFormat='Installed {0:MMM d, yyyy}'}"
                                                                           Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding InstallPath}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="10" Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis" Opacity="0.6"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110">
                                                        <Button Content="Open GitHub"
                                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="10,6"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Upgrade"
                                                                Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="10,6"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Remove"
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="10,6"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         UPDATES PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsUpdatesPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" Margin="0"/>
                                        <Border Style="{StaticResource UpdateBadge}"
                                                Visibility="{Binding HasPendingUpdates, Converter={StaticResource BoolToVis}}"
                                                Margin="10,0,0,12">
                                            <TextBlock Text="{Binding UpdateCountText}"
                                                       Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Apps with newer versions available on GitHub."
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Check All" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Update All"
                                            Command="{Binding UpdateAllCommand}"
                                            Visibility="{Binding HasPendingUpdates, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasPendingUpdates, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="✔" FontSize="48" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StoreSuccess}"/>
                                        <TextBlock Text="Everything is up to date"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Run Check All to scan installed apps for new releases."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding AppsWithUpdates}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="10"
                                                            Background="{DynamicResource StoreSoftAccent}"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding AvatarUrl}" Width="40" Height="40"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}"
                                                                   Foreground="{DynamicResource StoreText}"
                                                                   FontSize="15" FontWeight="Bold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Version}"
                                                                       Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                                            <TextBlock Text=" → "
                                                                       Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                                            <TextBlock Text="{Binding LatestVersion}"
                                                                       Foreground="{DynamicResource StoreSuccess}"
                                                                       FontSize="13" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="Upgrade"
                                                            Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         WINDOWS APPS PAGE (registry programs)
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsWindowsAppsPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows Apps" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="{Binding WindowsAppsStatus}"
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding WindowsAppsFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="220" FontSize="12" Padding="10,7"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                            Command="{Binding LoadWindowsAppsCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <!-- Empty state -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoWindowsApps, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="🖥" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No programs found"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Click Refresh to scan the Windows registry for installed programs."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding WindowsApps}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource StoreText}"
                                                                   FontSize="15" FontWeight="Bold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding Publisher}"
                                                                       Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="12" Margin="0,0,12,0"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="v" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding DisplayVersion}"
                                                                               Foreground="{DynamicResource StoreAccent}"
                                                                               FontSize="11"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                                <TextBlock Text="{Binding SizeDisplay}"
                                                                           Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="11" Margin="0,3,0,0" Opacity="0.7">
                                                            <TextBlock.Text>
                                                                <Binding Path="InstallDate" StringFormat="Installed: {0}"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding InstallLocation}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="10" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" Opacity="0.5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Uninstall"
                                                            Command="{Binding DataContext.UninstallWindowsAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Setter Property="Padding" Value="12,7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanUninstall}" Value="False">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.35"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         STARTUP PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsStartupPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Startup Manager" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="{Binding StartupStatus}"
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}"
                                        Command="{Binding LoadStartupCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <!-- Info banner -->
                                <Border Background="{DynamicResource StoreAccentLight}"
                                        BorderBrush="{DynamicResource StoreAccent}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14">
                                    <TextBlock Foreground="{DynamicResource StoreAccent}" FontSize="13" TextWrapping="Wrap">
                                        Entries listed here run automatically when you log in to Windows. Disabling an entry prevents it from launching at startup without deleting it — you can re-enable it at any time. Deleting removes it from the registry permanently.
                                    </TextBlock>
                                </Border>

                                <!-- Empty state -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoStartupEntries, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No startup entries found"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Click Refresh to read the Windows registry startup keys."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding StartupEntries}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource StoreText}"
                                                                       FontSize="15" FontWeight="Bold"/>
                                                            <!-- Enabled/Disabled badge -->
                                                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="8" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource StoreSuccessLight}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource StoreSuccess}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Background" Value="{DynamicResource StoreSurfaceAlt}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource StoreBorder}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StoreSuccess}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource StoreSubText}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- Source badge -->
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="8"
                                                                    Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Source}"
                                                                           Foreground="{DynamicResource StoreSubText}"
                                                                           FontSize="11"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,5,0,0" Opacity="0.65"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Enable (shown when disabled) -->
                                                        <Button Content="Enable"
                                                                Command="{Binding DataContext.EnableStartupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Enabled, Converter={StaticResource InvBoolToVis}}"
                                                                Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <!-- Disable (shown when enabled) -->
                                                        <Button Content="Disable"
                                                                Command="{Binding DataContext.DisableStartupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Delete"
                                                                Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         SYSTEM CLEANER PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsCleanerPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="System Cleaner" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="Scan and remove temporary files to free disk space."
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Scan All"
                                        Command="{Binding ScanCleanerCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                                <!-- Clean status banner -->
                                <Border Background="{DynamicResource StoreSuccessLight}"
                                        BorderBrush="{DynamicResource StoreSuccess}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12"
                                        Visibility="{Binding HasCleanStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CleanStatus}"
                                               Foreground="{DynamicResource StoreSuccess}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Empty state (before first scan) -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoCleanerTargets, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="✦" FontSize="48" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StoreAccent}"/>
                                        <TextBlock Text="Click Scan All to analyse your system"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Scans %TEMP%, Windows Temp, thumbnail cache and the store download folder."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cleaner target cards -->
                                <ListBox ItemsSource="{Binding CleanerTargets}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource StoreText}"
                                                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Size: " Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                                                    <TextBlock Text="{Binding SizeDisplay}"
                                                                               Foreground="{DynamicResource StoreText}"
                                                                               FontSize="13" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="12,5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Files: " Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                                                    <TextBlock Text="{Binding FileCount}"
                                                                               Foreground="{DynamicResource StoreText}"
                                                                               FontSize="13" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FolderPath}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="10" Margin="0,6,0,0"
                                                                   TextTrimming="CharacterEllipsis" Opacity="0.55"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Clean"
                                                            Command="{Binding DataContext.CleanTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Top">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                <Setter Property="FontSize" Value="13"/>
                                                                <Setter Property="Padding" Value="18,9"/>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         WINGET PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsWingetPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Winget — Package Manager" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="{Binding WingetStatus}"
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding WingetQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Width="220" FontSize="12" Padding="10,7"
                                             Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding WingetSearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="Search" Command="{Binding WingetSearchCommand}" Margin="0,0,6,0"/>
                                    <!-- Loading indicator -->
                                    <TextBlock Text="⟳" Foreground="{DynamicResource StoreAccent}"
                                               FontSize="18" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding IsWingetLoading, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <!-- winget not available warning -->
                                <Border Background="{DynamicResource StoreWarningLight}"
                                        BorderBrush="{DynamicResource StoreWarning}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14"
                                        Visibility="{Binding WingetNotAvailable, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="winget is not installed on this system"
                                                   Foreground="{DynamicResource StoreWarning}"
                                                   FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{DynamicResource StoreText}" FontSize="13" TextWrapping="Wrap">
                                            Windows Package Manager (winget) is required. Install it from the Microsoft Store (App Installer) or by running: winget install winget
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Empty results state -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoWingetResults, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Search for packages"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Type a package name above and press Search — or the page loads installed packages automatically."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding WingetResults}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource StoreText}"
                                                                   FontSize="15" FontWeight="Bold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Id}"
                                                                           Foreground="{DynamicResource StoreAccent}"
                                                                           FontSize="11" FontFamily="Consolas"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="v" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Version}"
                                                                               Foreground="{DynamicResource StoreText}" FontSize="11"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- Update available badge -->
                                                            <Border Background="{DynamicResource StoreWarningLight}"
                                                                    BorderBrush="{DynamicResource StoreWarning}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,3"
                                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="→ " Foreground="{DynamicResource StoreWarning}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding AvailableVersion}"
                                                                               Foreground="{DynamicResource StoreWarning}"
                                                                               FontSize="11" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Source}"
                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                   FontSize="10" Margin="0,3,0,0" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Install"
                                                                Command="{Binding DataContext.WingetInstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Upgrade"
                                                                Command="{Binding DataContext.WingetUpgradeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,0,6,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Uninstall"
                                                                Command="{Binding DataContext.WingetUninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="Padding" Value="12,7"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         PROFILE PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <ScrollViewer Visibility="{Binding IsProfilePage, Converter={StaticResource BoolToVis}}"
                                  Padding="24,20,24,20">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Profile" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Your GitHub identity and Windows account information."
                                       Style="{StaticResource PageSubtitle}"/>

                            <!-- Loading indicator -->
                            <Border Background="{DynamicResource StoreAccentLight}"
                                    BorderBrush="{DynamicResource StoreAccent}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,9"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsProfileLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⟳ Loading profile…" Foreground="{DynamicResource StoreAccent}" FontSize="13"/>
                            </Border>

                            <!-- Not connected banner -->
                            <Border Background="{DynamicResource StoreWarningLight}"
                                    BorderBrush="{DynamicResource StoreWarning}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource InvBoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No GitHub account connected"
                                               Foreground="{DynamicResource StoreWarning}"
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Add your Personal Access Token in Settings to unlock GitHub profile data, higher API rate limits, and private repo access."
                                               Foreground="{DynamicResource StoreText}"
                                               FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Avatar + identity card -->
                            <Border Style="{StaticResource StoreCard}" Padding="28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar: initials fallback + GitHub image overlay -->
                                    <Grid Margin="0,0,24,0" VerticalAlignment="Top" Width="90" Height="90">
                                        <Border Style="{StaticResource AvatarCircle}" Width="90" Height="90">
                                            <TextBlock Text="{Binding Profile.Initials}"
                                                       Foreground="{DynamicResource StoreAccent}"
                                                       FontSize="38" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- GitHub avatar (overlaid when profile is connected) -->
                                        <Border Width="90" Height="90" CornerRadius="45" ClipToBounds="True"
                                                Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding Profile.AvatarUrl}"
                                                   Width="90" Height="90" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profile.DisplayName}"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Profile.Login, StringFormat='@{0}'}"
                                                   Foreground="{DynamicResource StoreAccent}"
                                                   FontSize="14" Margin="0,3,0,0"
                                                   Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Profile.Bio}"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Info pills -->
                                        <WrapPanel Margin="0,8,0,0"
                                                   Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📍 " FontSize="12"/>
                                                    <TextBlock Text="{Binding Profile.Location}"
                                                               Foreground="{DynamicResource StoreSubText}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏢 " FontSize="12"/>
                                                    <TextBlock Text="{Binding Profile.CompanyClean}"
                                                               Foreground="{DynamicResource StoreSubText}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                    BorderBrush="{DynamicResource StoreBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✉ " FontSize="12"/>
                                                    <TextBlock Text="{Binding Profile.Email}"
                                                               Foreground="{DynamicResource StoreSubText}" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource StoreAccentLight}"
                                                    BorderBrush="{DynamicResource StoreAccent}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding Profile.MemberSince}"
                                                           Foreground="{DynamicResource StoreAccent}" FontSize="12"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- GitHub stats (only when connected) -->
                            <Border Style="{StaticResource StoreCard}"
                                    Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="GitHub Stats" Foreground="{DynamicResource StoreText}"
                                               FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Border Style="{StaticResource StatCard}" MinWidth="130">
                                            <StackPanel>
                                                <TextBlock Text="Repositories" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                <TextBlock Text="{Binding Profile.PublicRepos}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}" MinWidth="130">
                                            <StackPanel>
                                                <TextBlock Text="Followers" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                <TextBlock Text="{Binding Profile.Followers}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}" MinWidth="130">
                                            <StackPanel>
                                                <TextBlock Text="Following" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                <TextBlock Text="{Binding Profile.Following}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- GitHub bio card (only when connected) -->
                            <Border Style="{StaticResource StoreCard}"
                                    Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="About" Foreground="{DynamicResource StoreText}"
                                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Profile.Bio}"
                                               Foreground="{DynamicResource StoreSubText}"
                                               FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Windows account -->
                            <Border Style="{StaticResource StoreCard}">
                                <StackPanel>
                                    <TextBlock Text="Windows Account" Foreground="{DynamicResource StoreText}"
                                               FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource AvatarCircle}" Width="48" Height="48" Margin="0,0,16,0">
                                            <TextBlock Text="🖥" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Foreground="{DynamicResource StoreText}" FontSize="15" FontWeight="SemiBold">
                                                <Run Text="{Binding Profile.WindowsUser}"/>
                                                <Run Text=" @ "/>
                                                <Run Text="{Binding Profile.ComputerName}"/>
                                            </TextBlock>
                                            <TextBlock Text="Local Windows account"
                                                       Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                                <Button Content="Refresh Profile" Command="{Binding LoadProfileCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Padding" Value="18,9"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Open GitHub Profile"
                                        Command="{Binding OpenProfileUrlCommand}"
                                        Margin="8,3,3,3"
                                        Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Padding" Value="18,9"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Go to Settings"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Settings"
                                        Margin="8,3,3,3"
                                        Visibility="{Binding Profile.HasGitHubProfile, Converter={StaticResource InvBoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Padding" Value="18,9"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════════════════════════════════════════
                         SETTINGS PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}"
                                  Padding="24,20,24,20">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Configure your GitHub App Store preferences. Settings are saved to your user profile."
                                       Style="{StaticResource PageSubtitle}"/>

                            <!-- GitHub section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="GitHub" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <!-- Token -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Personal Access Token" Foreground="{DynamicResource StoreText}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Increases API rate limit from 60 to 5,000 requests/hour."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding SettingsToken, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="240" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Token validation row -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TokenValidStatus}"
                                                           Foreground="{DynamicResource StoreAccent}" FontSize="13" FontWeight="SemiBold"
                                                           Visibility="{Binding HasTokenValidStatus, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="Test your token to verify it works and load your GitHub profile."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12"
                                                           Visibility="{Binding HasTokenValidStatus, Converter={StaticResource InvBoolToVis}}"/>
                                                <TextBlock Text="⟳ Validating…" Foreground="{DynamicResource StoreAccent}" FontSize="12"
                                                           Visibility="{Binding IsTokenValidating, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Test Token"
                                                    Command="{Binding ValidateTokenCommand}"
                                                    Margin="16,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="14,8"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- Auto-check updates -->
                                    <Border Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Auto-check Updates"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Scan installed apps for new releases when opening the Updates page."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SettingsAutoUpdate}"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Search section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Search" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Results Per Page"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Number of repositories returned per search (10–100)."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding SettingsResultsPerPage, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="80" FontSize="13" TextAlignment="Center"
                                                     Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Include Forks"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Include forked repositories in search results."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Appearance section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Appearance" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <Border Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Dark Mode"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Switch between light and dark themes instantly."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SettingsDarkMode}"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- General section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="General" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <!-- Download folder -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Download Folder"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Where downloaded releases and zip archives are saved."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBox Text="{Binding SettingsDownloadFolder, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="180" FontSize="12"/>
                                                <Button Content="Browse…"
                                                        Command="{Binding BrowseDownloadFolderCommand}"
                                                        Margin="6,3,3,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Setter Property="Padding" Value="10,7"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Notifications toggle -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Show Notifications"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Display notifications for install and update completions."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SettingsShowNotifications}"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <!-- Minimize on close -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Minimize to System Tray on Close"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Keep the app running in the background instead of closing."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SettingsMinimizeOnClose}"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <!-- Start at login -->
                                    <Border Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Start at Windows Login"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Automatically launch GitHub App Store when you sign in."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Cache &amp; Performance section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Cache &amp; Performance" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Enable Search Cache"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Store search results to reduce API calls."
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="20,14">
                                        <Button Content="Clear Cache"
                                                Width="100"
                                                HorizontalAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Padding" Value="12,7"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- App Store Updates section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="App Store Updates" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Current version + check button row -->
                                    <Border Style="{StaticResource SettingsRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Current Version" Foreground="{DynamicResource StoreText}"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{DynamicResource StoreAccentLight}"
                                                            CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding StoreCurrentVersion, StringFormat='v{0}'}"
                                                                   Foreground="{DynamicResource StoreAccent}"
                                                                   FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Check for Updates"
                                                    Command="{Binding CheckStoreUpdateCommand}"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="14,8"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Checking indicator row -->
                                    <Border Padding="20,10"
                                            Visibility="{Binding IsCheckingStoreUpdate, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⟳" FontSize="14" Foreground="{DynamicResource StoreAccent}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Checking GitHub for updates…"
                                                       Foreground="{DynamicResource StoreSubText}" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status + download row (shown when there's a result) -->
                                    <Border Padding="20,14"
                                            Visibility="{Binding HasStoreUpdateStatus, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StoreUpdateStatus}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="13" TextWrapping="Wrap"/>
                                                <!-- Version comparison: old → new (only when update available) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding HasStoreUpdate, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="{DynamicResource StoreDangerLight}"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding StoreCurrentVersion, StringFormat='v{0}'}"
                                                                   Foreground="{DynamicResource StoreDanger}"
                                                                   FontSize="11" TextDecorations="Strikethrough"/>
                                                    </Border>
                                                    <TextBlock Text="→" Foreground="{DynamicResource StoreAccent}"
                                                               FontSize="13" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Background="{DynamicResource StoreSuccessLight}"
                                                            CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding StoreLatestVersion}"
                                                                   Foreground="{DynamicResource StoreSuccess}"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Download Update"
                                                    Command="{Binding DownloadStoreUpdateCommand}"
                                                    Visibility="{Binding HasStoreUpdate, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Padding" Value="14,8"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- About section -->
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Border Padding="20,14" BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="About" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    <Border Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource AvatarCircle}" Width="52" Height="52" Margin="0,0,16,0">
                                                <TextBlock Text="★" FontSize="24" Foreground="{DynamicResource StoreAccent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="GitHub App Store"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Version 1.0  •  Powered by GitHub REST API"
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,3,0,0"/>
                                                <TextBlock Text="Built with WPF &amp; .NET 8"
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="12" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Save button -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Padding" Value="24,10"/>
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Background="{DynamicResource StoreSuccessLight}"
                                        BorderBrush="{DynamicResource StoreSuccess}"
                                        BorderThickness="1" CornerRadius="9"
                                        Padding="14,10" Margin="10,3,0,3"
                                        Visibility="{Binding HasSettingsStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SettingsStatus}"
                                               Foreground="{DynamicResource StoreSuccess}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════════════════════════════════════════
                         SYSTEM INFO PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsSysInfoPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="System Information" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="Hardware, OS, memory, storage and network details."
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⟳" Foreground="{DynamicResource StoreAccent}"
                                               FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding IsSysInfoLoading, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                            Command="{Binding LoadSysInfoCommand}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <!-- Empty state -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding IsSysInfoNotLoaded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="ℹ" FontSize="48" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StoreAccent}"/>
                                        <TextBlock Text="Click Refresh to load system information"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Shows OS, CPU, RAM, disk usage, and network adapters."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Content (only when loaded) -->
                                <StackPanel Visibility="{Binding IsSysInfoLoaded, Converter={StaticResource BoolToVis}}">

                                    <!-- OS & CPU stat cards -->
                                    <TextBlock Text="System" Foreground="{DynamicResource StoreText}"
                                               FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <Border Style="{StaticResource StatCard}" MinWidth="200">
                                            <StackPanel>
                                                <TextBlock Text="Operating System" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.OsDescription}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}" MinWidth="180">
                                            <StackPanel>
                                                <TextBlock Text="CPU" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.CpuName}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="Processor Cores" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.ProcessorCount}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="22" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="Architecture" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.Architecture}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="Uptime" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.Uptime}"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}" MinWidth="180">
                                            <StackPanel>
                                                <TextBlock Text=".NET Runtime" Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SysInfo.DotNetVersion}"
                                                           Foreground="{DynamicResource StoreAccent}"
                                                           FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Memory section -->
                                    <Border Style="{StaticResource StoreCard}" Margin="0,4,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Memory (RAM)"
                                                           Foreground="{DynamicResource StoreText}"
                                                           FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SysInfo.RamUsedPercent, StringFormat={}{0}% used}"
                                                           Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SysInfo.RamDisplay}"
                                                       Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="13" Margin="0,0,0,10"/>
                                            <!-- RAM bar — color based on usage -->
                                            <ProgressBar Value="{Binding SysInfo.RamUsedPercent}" Maximum="100" Height="10">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SysInfo.RamUsedPercent}" Value="90">
                                                                <Setter Property="Foreground" Value="{DynamicResource StoreDanger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Border>

                                    <!-- Disks section -->
                                    <TextBlock Text="Storage" Foreground="{DynamicResource StoreText}"
                                               FontSize="15" FontWeight="Bold" Margin="0,4,0,10"/>
                                    <ListBox ItemsSource="{Binding SysInfo.Disks}" Margin="0,0,0,4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StoreCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding LabelDisplay}"
                                                                           Foreground="{DynamicResource StoreText}"
                                                                           FontSize="15" FontWeight="Bold"/>
                                                                <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                        BorderBrush="{DynamicResource StoreBorder}"
                                                                        BorderThickness="1" CornerRadius="6"
                                                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DriveFormat}"
                                                                               Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SummaryDisplay}"
                                                                       Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="13" Margin="0,0,0,8"/>
                                                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsedPercent}" Value="90">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StoreDanger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="100">
                                                            <TextBlock Text="{Binding FreeDisplay}"
                                                                       Foreground="{DynamicResource StoreSuccess}"
                                                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="free" Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="11" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding TotalDisplay}"
                                                                       Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Network section -->
                                    <TextBlock Text="Network Adapters" Foreground="{DynamicResource StoreText}"
                                               FontSize="15" FontWeight="Bold" Margin="0,4,0,10"/>
                                    <ListBox ItemsSource="{Binding SysInfo.NetworkAdapters}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StoreCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource StoreText}"
                                                                           FontSize="14" FontWeight="Bold"/>
                                                                <!-- Up/Down badge -->
                                                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="8" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource StoreSuccessLight}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource StoreSuccess}"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                                                    <Setter Property="Background" Value="{DynamicResource StoreSurfaceAlt}"/>
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StoreBorder}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StoreSuccess}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource StoreSubText}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="12" Margin="0,0,0,6"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                        BorderBrush="{DynamicResource StoreBorder}"
                                                                        BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="IP: " Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                        <TextBlock Text="{Binding IpAddress}"
                                                                                   Foreground="{DynamicResource StoreText}"
                                                                                   FontSize="11" FontFamily="Consolas"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                                        BorderBrush="{DynamicResource StoreBorder}"
                                                                        BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="MAC: " Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                                                        <TextBlock Text="{Binding MacAddress}"
                                                                                   Foreground="{DynamicResource StoreSubText}"
                                                                                   FontSize="11" FontFamily="Consolas"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                            <TextBlock Text="{Binding Speed}"
                                                                       Foreground="{DynamicResource StoreAccent}"
                                                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="Link speed" Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         PROCESS MANAGER PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsProcessPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Process Manager" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="{Binding ProcessStatus}"
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="200" FontSize="12" Padding="10,7"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⟳" Foreground="{DynamicResource StoreAccent}"
                                               FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding IsProcessLoading, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                            Command="{Binding LoadProcessesCommand}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <!-- Warning banner -->
                                <Border Background="{DynamicResource StoreWarningLight}"
                                        BorderBrush="{DynamicResource StoreWarning}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                    <TextBlock Foreground="{DynamicResource StoreWarning}" FontSize="13" TextWrapping="Wrap">
                                        Killing a system process may cause instability or data loss. Only terminate processes you recognise as non-essential.
                                    </TextBlock>
                                </Border>

                                <!-- Empty state -->
                                <Border Style="{StaticResource StoreCard}"
                                        Visibility="{Binding HasNoProcesses, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                        <TextBlock Text="⚙" FontSize="48" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StoreAccent}"/>
                                        <TextBlock Text="Click Refresh to load running processes"
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock Text="Processes are sorted by memory usage, highest first."
                                                   Foreground="{DynamicResource StoreSubText}"
                                                   FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Process list -->
                                <ListBox ItemsSource="{Binding Processes}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StoreCard}" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource StoreText}"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Foreground="{DynamicResource StoreSubText}" FontSize="11" Margin="0,2,0,0">
                                                            <Run Text="PID"/>
                                                            <Run Text="{Binding Id}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource StoreSurfaceAlt}"
                                                            BorderBrush="{DynamicResource StoreBorder}"
                                                            BorderThickness="1" CornerRadius="8" Padding="12,6"
                                                            Margin="12,0" VerticalAlignment="Center" MinWidth="80">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding MemoryDisplay}"
                                                                       Foreground="{DynamicResource StoreText}"
                                                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="Memory" Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="10" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Kill"
                                                            Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Setter Property="Padding" Value="12,7"/>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         ENVIRONMENT VARIABLES PAGE
                    ══════════════════════════════════════════════════════════ -->
                    <Grid Visibility="{Binding IsEnvVarsPage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSurface}"
                                BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,0,0,1"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Environment Variables" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <TextBlock Text="{Binding EnvVarStatus}"
                                               Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding EnvVarFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="180" FontSize="12" Padding="10,7"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                            Command="{Binding LoadEnvVarsCommand}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="+ New" Command="{Binding NewEnvVarCommand}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Two-panel content area -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: variable list -->
                            <ScrollViewer Grid.Column="0" Padding="20,16,10,16">
                                <StackPanel>
                                    <!-- Empty state -->
                                    <Border Style="{StaticResource StoreCard}"
                                            Visibility="{Binding HasNoEnvVars, Converter={StaticResource BoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                            <TextBlock Text="🔧" FontSize="48" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Click Refresh to load environment variables"
                                                       Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                            <TextBlock Text="Shows User and Machine-level variables. Machine variables are read-only."
                                                       Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <ListBox ItemsSource="{Binding EnvVariables}"
                                             SelectedItem="{Binding SelectedEnvVar, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StoreCard}" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource StoreText}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ValuePreview}"
                                                                       Foreground="{DynamicResource StoreSubText}"
                                                                       FontSize="11" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <!-- Scope badge -->
                                                        <Border Grid.Column="1" Padding="8,3" CornerRadius="8" VerticalAlignment="Top">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StoreAccent}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMachineScope}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource StoreWarningLight}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource StoreWarning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Scope}" FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMachineScope}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StoreWarning}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right: editor panel -->
                            <Border Grid.Column="1" Background="{DynamicResource StoreSurface}"
                                    BorderBrush="{DynamicResource StoreBorder}" BorderThickness="1,0,0,0">
                                <ScrollViewer Padding="20,20">
                                    <StackPanel>
                                        <TextBlock Text="Edit Variable" Foreground="{DynamicResource StoreText}"
                                                   FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>

                                        <!-- Placeholder when nothing selected/new -->
                                        <Border Background="{DynamicResource StoreSurfaceAlt}"
                                                BorderBrush="{DynamicResource StoreBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,12"
                                                Visibility="{Binding IsEditingEnvVar, Converter={StaticResource InvBoolToVis}}">
                                            <TextBlock Text="Select a variable from the list, or click + New to create a User variable."
                                                       Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="13" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Edit form (visible when editing) -->
                                        <StackPanel Visibility="{Binding IsEditingEnvVar, Converter={StaticResource BoolToVis}}">
                                            <!-- Machine scope read-only warning -->
                                            <Border Background="{DynamicResource StoreWarningLight}"
                                                    BorderBrush="{DynamicResource StoreWarning}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                                <TextBlock Text="Machine-scoped variables are read-only. Select a User variable to edit or delete."
                                                           Foreground="{DynamicResource StoreWarning}" FontSize="12" TextWrapping="Wrap"/>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedEnvVar.IsMachineScope}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <TextBlock Text="Name" Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding EditEnvName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" FontSize="13" Margin="0,0,0,12"/>

                                            <TextBlock Text="Value" Foreground="{DynamicResource StoreSubText}"
                                                       FontSize="12" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding EditEnvValue, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" FontSize="12"
                                                     TextWrapping="Wrap" Height="80"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="0,0,0,12"/>

                                            <!-- Status feedback -->
                                            <TextBlock Text="{Binding EnvVarStatus}"
                                                       Foreground="{DynamicResource StoreAccent}"
                                                       FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                            <Button Content="Save Variable"
                                                    Command="{Binding SaveEnvVarCommand}"
                                                    Margin="0,0,0,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Padding" Value="14,9"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Delete Variable"
                                                    Command="{Binding DeleteEnvVarCommand}"
                                                    Visibility="{Binding HasSelectedUserVar, Converter={StaticResource BoolToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                        <Setter Property="Padding" Value="14,9"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- Download progress bar (floating bottom) -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" Grid.ZIndex="50"
                        Background="{DynamicResource StoreSurface}"
                        BorderBrush="{DynamicResource StoreBorder}" BorderThickness="0,1,0,0"
                        Padding="20,12"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding DownloadLabel}"
                                       Foreground="{DynamicResource StoreText}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                                       Foreground="{DynamicResource StoreSubText}"
                                       FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="10"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ APP DETAIL OVERLAY ═══ -->
            <Grid Grid.ColumnSpan="2" Grid.ZIndex="100"
                  Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                <Rectangle Fill="#88000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                    </Rectangle.InputBindings>
                </Rectangle>
                <Border Width="500" HorizontalAlignment="Right"
                        Background="{DynamicResource StoreSurface}"
                        BorderBrush="{DynamicResource StoreBorder}"
                        BorderThickness="1,0,0,0"
                        Effect="{DynamicResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource StoreSoftAccent}" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="52" Height="52" CornerRadius="12"
                                            Background="{DynamicResource StoreSurface}">
                                        <Image Source="{Binding SelectedApp.Owner.AvatarUrl}"
                                               Width="48" Height="48"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedApp.Name}"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedApp.Owner.Login}"
                                                   Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕"
                                        Command="{Binding CloseDetailCommand}"
                                        VerticalAlignment="Top">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="24,16">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedApp.FullName}"
                                           Foreground="{DynamicResource StoreSubText}"
                                           FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedApp.Description}"
                                           Foreground="{DynamicResource StoreText}"
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="{DynamicResource StoreSurfaceAlt}"
                                            BorderBrush="{DynamicResource StoreBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="★ Stars" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedApp.Stars, StringFormat={}{0:N0}}"
                                                       Foreground="{DynamicResource StoreWarning}"
                                                       FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource StoreSurfaceAlt}"
                                            BorderBrush="{DynamicResource StoreBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="⑂ Forks" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedApp.Forks, StringFormat={}{0:N0}}"
                                                       Foreground="{DynamicResource StoreText}"
                                                       FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource StoreSurfaceAlt}"
                                            BorderBrush="{DynamicResource StoreBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <StackPanel>
                                            <TextBlock Text="Language" Foreground="{DynamicResource StoreSubText}" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedApp.Language}"
                                                       Foreground="{DynamicResource StoreAccent}"
                                                       FontSize="14" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Background="{DynamicResource StoreSuccessLight}"
                                        BorderBrush="{DynamicResource StoreSuccess}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Latest release: "
                                                   Foreground="{DynamicResource StoreSubText}" FontSize="13"/>
                                        <TextBlock Text="{Binding SelectedAppLatestVersion}"
                                                   Foreground="{DynamicResource StoreSuccess}"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Get (Install)"
                                            Command="{Binding InstallCommand}"
                                            CommandParameter="{Binding SelectedApp}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Open GitHub"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenCommand}"
                                            CommandParameter="{Binding SelectedApp}"/>
                                </StackPanel>

                                <TextBlock Text="Clone URL" Foreground="{DynamicResource StoreSubText}"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource StoreSurfaceAlt}"
                                            BorderBrush="{DynamicResource StoreBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <TextBlock Text="{Binding SelectedApp.CloneUrl}"
                                                   Foreground="{DynamicResource StoreText}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Copy"
                                            Command="{Binding CopyCloneCommand}"
                                            CommandParameter="{Binding SelectedApp}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Padding" Value="12,8"/>
                                                <Setter Property="Margin" Value="6,0,0,0"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <StatusBar Grid.Row="1">
            <TextBlock Text="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>
