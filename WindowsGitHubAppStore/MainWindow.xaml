<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows GitHub App Store" Height="820" Width="1400" Background="#111827"><Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="15"/></Style></Window.Resources><DockPanel><StatusBar DockPanel.Dock="Bottom" Background="#0F172A" Foreground="White"><TextBlock Text="{Binding StatusText}"/></StatusBar><StackPanel DockPanel.Dock="Left" Width="170" Background="#0F172A"><TextBlock Text="Categories" Foreground="White" FontSize="20" FontWeight="Bold" Margin="12"/><Button Content="AI" Command="{Binding CategoryCommand}" CommandParameter="artificial intelligence app"/><Button Content="Games" Command="{Binding CategoryCommand}" CommandParameter="game engine windows"/><Button Content="Editors" Command="{Binding CategoryCommand}" CommandParameter="text editor app"/><Button Content="Browsers" Command="{Binding CategoryCommand}" CommandParameter="web browser app"/><Button Content="Terminals" Command="{Binding CategoryCommand}" CommandParameter="terminal emulator"/><Button Content="Dev Tools" Command="{Binding CategoryCommand}" CommandParameter="developer tool"/></StackPanel><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="GitHub App Store" Foreground="White" FontSize="34" FontWeight="Bold"/><TextBlock Text="Find apps, programs, tools, games, editors, browsers, terminals, and open-source software from GitHub." Foreground="#CBD5E1" FontSize="15" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><TextBox Width="520" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search GitHub" Command="{Binding SearchCommand}"/></StackPanel></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Repositories}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#1F2937" CornerRadius="14" Padding="18" Margin="6" BorderBrush="#334155" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FullName}" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="Language: " Foreground="#94A3B8"/><TextBlock Text="{Binding Language}" Foreground="White" Margin="0,0,18,0"/><TextBlock Text="Stars: " Foreground="#94A3B8"/><TextBlock Text="{Binding Stars}" Foreground="White" Margin="0,0,18,0"/><TextBlock Text="Forks: " Foreground="#94A3B8"/><TextBlock Text="{Binding Forks}" Foreground="White"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Download ZIP" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Copy Clone" Command="{Binding DataContext.CopyCloneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></DockPanel></Window>