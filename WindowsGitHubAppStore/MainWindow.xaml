<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitHub Store" Height="860" Width="1500" Background="{StaticResource StoreBackground}"><DockPanel><StatusBar DockPanel.Dock="Bottom" Background="{StaticResource StoreSurface}" Foreground="{StaticResource StoreSubText}"><TextBlock Text="{Binding StatusText}"/></StatusBar><Border DockPanel.Dock="Left" Width="225" Background="{StaticResource StoreSurface}" BorderBrush="{StaticResource StoreBorder}" BorderThickness="0,0,1,0"><StackPanel Margin="16"><TextBlock Text="GitHub Store" Foreground="{StaticResource StoreText}" FontSize="26" FontWeight="Bold" Margin="0,10,0,24"/><Button Style="{StaticResource NavButton}" Content="Home" Command="{Binding CategoryCommand}" CommandParameter="windows app"/><Button Style="{StaticResource NavButton}" Content="AI" Command="{Binding CategoryCommand}" CommandParameter="artificial intelligence app"/><Button Style="{StaticResource NavButton}" Content="Games" Command="{Binding CategoryCommand}" CommandParameter="game engine windows"/><Button Style="{StaticResource NavButton}" Content="Editors" Command="{Binding CategoryCommand}" CommandParameter="text editor app"/><Button Style="{StaticResource NavButton}" Content="Browsers" Command="{Binding CategoryCommand}" CommandParameter="web browser app"/><Button Style="{StaticResource NavButton}" Content="Terminals" Command="{Binding CategoryCommand}" CommandParameter="terminal emulator"/><Button Style="{StaticResource NavButton}" Content="Developer Tools" Command="{Binding CategoryCommand}" CommandParameter="developer tool"/><Separator Margin="0,20"/><TextBlock Text="Account" Foreground="{StaticResource StoreSubText}" FontWeight="Bold" Margin="4,0,0,6"/><TextBox Text="{Binding TokenText}" ToolTip="GitHub token"/><Button Content="Save Token" Command="{Binding SaveTokenCommand}"/><Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}"/><Button Content="Installed Apps" Command="{Binding LoadInstalledCommand}"/></StackPanel></Border><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource HeroCard}" Grid.ColumnSpan="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Discover Windows apps from GitHub" Foreground="{StaticResource StoreText}" FontSize="38" FontWeight="Bold"/><TextBlock Text="Search open-source apps, download releases, install packages, and track updates in one clean store." Foreground="{StaticResource StoreSubText}" FontSize="16" Margin="0,8,0,18"/><StackPanel Orientation="Horizontal"><TextBox Width="620" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="★" Foreground="{StaticResource StoreAccent}" FontSize="96" VerticalAlignment="Center" Margin="24,0"/></Grid></Border><StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Text="Featured apps" Foreground="{StaticResource StoreText}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding FeaturedApps}" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource StoreCard}" Width="305" Height="160"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="{Binding Owner.AvatarUrl}" Width="44" Height="44"/><StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource StoreText}"/><TextBlock Text="{Binding Owner.Login}" Foreground="{StaticResource StoreSubText}"/></StackPanel></StackPanel><TextBlock Text="{Binding Description}" Foreground="{StaticResource StoreSubText}" TextWrapping="Wrap" Height="42" Margin="0,10,0,6"/><Button Content="Get" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Apps" Foreground="{StaticResource StoreText}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding Repositories}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource StoreCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><Image Source="{Binding Owner.AvatarUrl}" Width="64" Height="64"/><StackPanel Grid.Column="1" Margin="8,0,14,0"><TextBlock Text="{Binding FullName}" Foreground="{StaticResource StoreText}" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource StoreSubText}" TextWrapping="Wrap"/><Border Height="82" CornerRadius="12" Margin="0,10,0,8" Background="{StaticResource StoreSoftAccent}"><Image Source="{Binding ScreenshotUrl}" Stretch="UniformToFill"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="Language " Foreground="{StaticResource StoreSubText}"/><TextBlock Text="{Binding Language}" FontWeight="Bold" Margin="0,0,18,0"/><TextBlock Text="★ " Foreground="{StaticResource StoreSubText}"/><TextBlock Text="{Binding Stars}" FontWeight="Bold" Margin="0,0,18,0"/><TextBlock Text="Forks " Foreground="{StaticResource StoreSubText}"/><TextBlock Text="{Binding Forks}" FontWeight="Bold"/></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Get" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Download" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Copy Clone" Command="{Binding DataContext.CopyCloneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StoreCard}"><StackPanel><TextBlock Text="Installed apps" Foreground="{StaticResource StoreText}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Your local app library" Foreground="{StaticResource StoreSubText}" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding InstalledApps}"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource StoreSurfaceAlt}" CornerRadius="12" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding FullName}" Foreground="{StaticResource StoreText}" FontWeight="Bold"/><TextBlock Text="{Binding Version}" Foreground="{StaticResource StoreAccent}"/><TextBlock Text="{Binding InstallPath}" Foreground="{StaticResource StoreSubText}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><Border Background="{StaticResource StoreSurface}" CornerRadius="10" Padding="18,8" Margin="8"><TextBlock Text="{Binding CurrentPage}" Foreground="{StaticResource StoreText}" FontSize="18" FontWeight="Bold"/></Border><Button Content="Next" Command="{Binding NextPageCommand}"/></StackPanel></Grid></DockPanel></Window>