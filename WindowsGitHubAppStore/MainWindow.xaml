<Window x:Class="WindowsGitHubAppStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows GitHub App Store" Height="860" Width="1500" Background="#111827"><Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="8"/></Style></Window.Resources><DockPanel><StatusBar DockPanel.Dock="Bottom" Background="#0F172A" Foreground="White"><TextBlock Text="{Binding StatusText}"/></StatusBar><StackPanel DockPanel.Dock="Left" Width="190" Background="#0F172A"><TextBlock Text="GitHub Store" Foreground="White" FontSize="24" FontWeight="Bold" Margin="12"/><Button Content="AI" Command="{Binding CategoryCommand}" CommandParameter="artificial intelligence app"/><Button Content="Games" Command="{Binding CategoryCommand}" CommandParameter="game engine windows"/><Button Content="Editors" Command="{Binding CategoryCommand}" CommandParameter="text editor app"/><Button Content="Browsers" Command="{Binding CategoryCommand}" CommandParameter="web browser app"/><Button Content="Terminals" Command="{Binding CategoryCommand}" CommandParameter="terminal emulator"/><Button Content="Dev Tools" Command="{Binding CategoryCommand}" CommandParameter="developer tool"/><Separator Margin="8"/><TextBlock Text="GitHub Token" Foreground="#CBD5E1" Margin="10"/><TextBox Text="{Binding TokenText}"/><Button Content="Save Token" Command="{Binding SaveTokenCommand}"/><Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}"/><Button Content="Reload Installed" Command="{Binding LoadInstalledCommand}"/></StackPanel><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.ColumnSpan="2"><TextBlock Text="Windows GitHub App Store" Foreground="White" FontSize="34" FontWeight="Bold"/><TextBlock Text="Search, download, install, and track open-source apps from GitHub." Foreground="#CBD5E1"/><StackPanel Orientation="Horizontal"><TextBox Width="560" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/></StackPanel></StackPanel><GroupBox Header="Featured Apps" Grid.Row="1" Grid.ColumnSpan="2" Foreground="White" Margin="0,8"><ListBox ItemsSource="{Binding FeaturedApps}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="310" Margin="6" Padding="10" Background="#1F2937" CornerRadius="12"><StackPanel><Image Source="{Binding Owner.AvatarUrl}" Width="42" Height="42"/><TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="#CBD5E1" TextWrapping="Wrap" Height="40"/><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox><ListBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Repositories}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="#1F2937" CornerRadius="14" Padding="14" Margin="6" BorderBrush="#334155" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Image Source="{Binding Owner.AvatarUrl}" Width="64" Height="64"/><TextBlock Text="{Binding Owner.Login}" Foreground="#CBD5E1" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding FullName}" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#CBD5E1" TextWrapping="Wrap"/><Image Source="{Binding ScreenshotUrl}" Height="90" Stretch="UniformToFill" Margin="0,8,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="Lang: " Foreground="#94A3B8"/><TextBlock Text="{Binding Language}" Foreground="White" Margin="0,0,15,0"/><TextBlock Text="Stars: " Foreground="#94A3B8"/><TextBlock Text="{Binding Stars}" Foreground="White" Margin="0,0,15,0"/><TextBlock Text="Forks: " Foreground="#94A3B8"/><TextBlock Text="{Binding Forks}" Foreground="White"/></StackPanel></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Download" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Install" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><Button Content="Copy Clone" Command="{Binding DataContext.CopyCloneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><GroupBox Header="Installed Apps" Grid.Row="2" Grid.Column="1" Foreground="White" Margin="8,0,0,0"><ListBox ItemsSource="{Binding InstalledApps}" Background="#111827"><ListBox.ItemTemplate><DataTemplate><Border Background="#1F2937" Margin="5" Padding="10" CornerRadius="10"><StackPanel><TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="Bold"/><TextBlock Text="{Binding Version}" Foreground="#CBD5E1"/><TextBlock Text="{Binding InstallPath}" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox><StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Previous Page" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding CurrentPage}" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="10"/><Button Content="Next Page" Command="{Binding NextPageCommand}"/></StackPanel></Grid></DockPanel></Window>