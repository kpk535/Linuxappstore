<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette -->
    <SolidColorBrush x:Key="StoreBackground"    Color="#111214"/>
    <SolidColorBrush x:Key="StoreSurface"       Color="#1C1D22"/>
    <SolidColorBrush x:Key="StoreSurfaceAlt"    Color="#242529"/>
    <SolidColorBrush x:Key="StoreBorder"        Color="#2E3038"/>
    <SolidColorBrush x:Key="StoreText"          Color="#F0F1F5"/>
    <SolidColorBrush x:Key="StoreSubText"       Color="#9199A8"/>
    <SolidColorBrush x:Key="StoreAccent"        Color="#4CA8F5"/>
    <SolidColorBrush x:Key="StoreAccentHover"   Color="#6BBCFF"/>
    <SolidColorBrush x:Key="StoreAccentLight"   Color="#152640"/>
    <SolidColorBrush x:Key="StoreSoftAccent"    Color="#152230"/>
    <SolidColorBrush x:Key="StoreDanger"        Color="#F04438"/>
    <SolidColorBrush x:Key="StoreDangerHover"   Color="#D92D20"/>
    <SolidColorBrush x:Key="StoreDangerLight"   Color="#3A1514"/>
    <SolidColorBrush x:Key="StoreWarning"       Color="#F79009"/>
    <SolidColorBrush x:Key="StoreWarningLight"  Color="#2D1D06"/>
    <SolidColorBrush x:Key="StoreSuccess"       Color="#17B26A"/>
    <SolidColorBrush x:Key="StoreSuccessLight"  Color="#082018"/>
    <SolidColorBrush x:Key="StoreSidebarBg"     Color="#161719"/>

    <DropShadowEffect x:Key="SoftShadow"  Color="#60000000" BlurRadius="24" ShadowDepth="3" Opacity="0.55"/>
    <DropShadowEffect x:Key="CardShadow"  Color="#40000000" BlurRadius="12" ShadowDepth="1" Opacity="0.40"/>

    <!-- Primary button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground"           Value="White"/>
        <Setter Property="Background"           Value="{DynamicResource StoreAccent}"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="FontWeight"           Value="SemiBold"/>
        <Setter Property="FontSize"             Value="13"/>
        <Setter Property="Padding"              Value="16,9"/>
        <Setter Property="Margin"               Value="3"/>
        <Setter Property="Cursor"               Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource StoreDanger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreDangerHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource StoreAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StoreAccent}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="Foreground"               Value="{DynamicResource StoreText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"                  Value="14,11"/>
        <Setter Property="Margin"                   Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin"           Value="3"/>
        <Setter Property="Padding"          Value="12,9"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Background"       Value="{DynamicResource StoreSurfaceAlt}"/>
        <Setter Property="Foreground"       Value="{DynamicResource StoreText}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CaretBrush"       Value="{DynamicResource StoreAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height"           Value="8"/>
        <Setter Property="Background"       Value="{DynamicResource StoreBorder}"/>
        <Setter Property="Foreground"       Value="{DynamicResource StoreAccent}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Track" CornerRadius="4">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="6"/>
        <Setter Property="Margin"     Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding"                  Value="0"/>
        <Setter Property="Margin"                   Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background"   Value="{DynamicResource StoreBorder}"/>
        <Setter Property="Margin"       Value="0,10"/>
        <Setter Property="Height"       Value="1"/>
    </Style>

    <Style x:Key="StoreCard" TargetType="Border">
        <Setter Property="Background"       Value="{DynamicResource StoreSurface}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="14"/>
        <Setter Property="Padding"          Value="16"/>
        <Setter Property="Margin"           Value="0,0,0,10"/>
        <Setter Property="Effect"           Value="{DynamicResource CardShadow}"/>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource StoreCard}">
        <Setter Property="Background"   Value="{DynamicResource StoreSoftAccent}"/>
        <Setter Property="Padding"      Value="28"/>
        <Setter Property="Margin"       Value="0,0,0,16"/>
        <Setter Property="Effect"       Value="{DynamicResource SoftShadow}"/>
    </Style>

    <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource StoreCard}">
        <Setter Property="Width"    Value="260"/>
        <Setter Property="Margin"   Value="0,0,12,0"/>
        <Setter Property="Padding"  Value="14"/>
    </Style>

    <Style x:Key="BadgePill" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource StoreAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="7,3"/>
    </Style>

    <Style x:Key="UpdateBadge" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource StoreWarning}"/>
        <Setter Property="CornerRadius"      Value="10"/>
        <Setter Property="Padding"           Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="6,0,0,0"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="{DynamicResource StoreText}"/>
        <Setter Property="FontSize"     Value="20"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Margin"       Value="0,0,0,12"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background"       Value="{DynamicResource StoreSurface}"/>
        <Setter Property="Foreground"       Value="{DynamicResource StoreSubText}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="16,4"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness"  Value="0,1,0,0"/>
    </Style>

</ResourceDictionary>
