<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════
         LIGHT PALETTE
    ════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="StoreBackground"    Color="#F2F4F8"/>
    <SolidColorBrush x:Key="StoreSurface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StoreSurfaceAlt"    Color="#F8F9FB"/>
    <SolidColorBrush x:Key="StoreBorder"        Color="#E3E6EF"/>
    <SolidColorBrush x:Key="StoreText"          Color="#15172A"/>
    <SolidColorBrush x:Key="StoreSubText"       Color="#636B80"/>
    <SolidColorBrush x:Key="StoreAccent"        Color="#0067C0"/>
    <SolidColorBrush x:Key="StoreAccentHover"   Color="#005BAD"/>
    <SolidColorBrush x:Key="StoreAccentLight"   Color="#E0EEFF"/>
    <SolidColorBrush x:Key="StoreSoftAccent"    Color="#EBF3FF"/>
    <SolidColorBrush x:Key="StoreDanger"        Color="#D92D20"/>
    <SolidColorBrush x:Key="StoreDangerHover"   Color="#B91C14"/>
    <SolidColorBrush x:Key="StoreDangerLight"   Color="#FEE4E2"/>
    <SolidColorBrush x:Key="StoreWarning"       Color="#D97706"/>
    <SolidColorBrush x:Key="StoreWarningLight"  Color="#FEF3C7"/>
    <SolidColorBrush x:Key="StoreSuccess"       Color="#059669"/>
    <SolidColorBrush x:Key="StoreSuccessLight"  Color="#D1FAE5"/>
    <SolidColorBrush x:Key="StoreSidebarBg"     Color="#ECEEF4"/>
    <SolidColorBrush x:Key="StoreCardBorderHover" Color="#0067C0"/>
    <SolidColorBrush x:Key="StoreToggleOff"     Color="#D0D5E0"/>
    <SolidColorBrush x:Key="StoreToggleThumb"   Color="#FFFFFF"/>

    <DropShadowEffect x:Key="SoftShadow"  Color="#20000000" BlurRadius="24" ShadowDepth="3" Opacity="0.24"/>
    <DropShadowEffect x:Key="CardShadow"  Color="#14000000" BlurRadius="12" ShadowDepth="1" Opacity="0.18"/>
    <DropShadowEffect x:Key="HoverShadow" Color="#200067C0" BlurRadius="18" ShadowDepth="0" Opacity="0.30"/>

    <!-- ════════════════════════════════════════════════════
         BUTTONS
    ════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="Background"      Value="{DynamicResource StoreAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="16,9"/>
        <Setter Property="Margin"          Value="3"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource StoreDanger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreDangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource StoreAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StoreAccent}" BorderThickness="1"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreAccentLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="Foreground"                Value="{DynamicResource StoreText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"                   Value="12,10"/>
        <Setter Property="Margin"                    Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource StoreBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         INPUTS
    ════════════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Margin"          Value="3"/>
        <Setter Property="Padding"         Value="12,9"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Background"      Value="{DynamicResource StoreSurface}"/>
        <Setter Property="Foreground"      Value="{DynamicResource StoreText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource StoreAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource StoreAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"       Value="{DynamicResource StoreText}"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11"
                                Background="{DynamicResource StoreToggleOff}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     Fill="{DynamicResource StoreToggleThumb}"
                                     Margin="3,0,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource StoreAccent}"/>
                            <Setter TargetName="Thumb" Property="Margin"              Value="0,0,3,0"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         PROGRESS BAR
    ════════════════════════════════════════════════════ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"          Value="8"/>
        <Setter Property="Background"      Value="{DynamicResource StoreBorder}"/>
        <Setter Property="Foreground"      Value="{DynamicResource StoreAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Track" CornerRadius="4">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger progress (for high disk usage) -->
    <Style x:Key="DangerProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{DynamicResource StoreDanger}"/>
    </Style>
    <Style x:Key="WarningProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{DynamicResource StoreWarning}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         LISTS & SCROLL
    ════════════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="5"/>
        <Setter Property="Margin"     Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding"                   Value="0"/>
        <Setter Property="Margin"                    Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="FocusVisualStyle"          Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource StoreBorder}"/>
        <Setter Property="Margin"     Value="0,8"/>
        <Setter Property="Height"     Value="1"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         CARD STYLES
    ════════════════════════════════════════════════════ -->
    <Style x:Key="StoreCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource StoreSurface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Padding"         Value="18"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Setter Property="Effect"          Value="{DynamicResource CardShadow}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush">
                    <Setter.Value><SolidColorBrush Color="#0067C0" Opacity="0.55"/></Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource StoreCard}">
        <Setter Property="Background" Value="{DynamicResource StoreSoftAccent}"/>
        <Setter Property="Padding"    Value="28"/>
        <Setter Property="Margin"     Value="0,0,0,20"/>
        <Setter Property="Effect"     Value="{DynamicResource SoftShadow}"/>
    </Style>

    <Style x:Key="FeatureCard" TargetType="Border" BasedOn="{StaticResource StoreCard}">
        <Setter Property="Width"   Value="265"/>
        <Setter Property="Margin"  Value="0,0,12,0"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- Compact metric / stat card -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource StoreSurface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="12"/>
        <Setter Property="Padding"         Value="16,12"/>
        <Setter Property="Margin"          Value="0,0,10,10"/>
        <Setter Property="Effect"          Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- Settings page section wrapper -->
    <Style x:Key="SettingsGroup" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource StoreSurface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Margin"          Value="0,0,0,16"/>
        <Setter Property="Effect"          Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- Individual row inside a SettingsGroup -->
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Padding"         Value="20,14"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="#F8F9FB"/></Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Profile avatar circle -->
    <Style x:Key="AvatarCircle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="999"/>
        <Setter Property="Background"      Value="{DynamicResource StoreSoftAccent}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StoreAccentLight}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         BADGES & LABELS
    ════════════════════════════════════════════════════ -->
    <Style x:Key="BadgePill" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource StoreAccent}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="7,3"/>
    </Style>

    <Style x:Key="UpdateBadge" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource StoreWarning}"/>
        <Setter Property="CornerRadius"      Value="10"/>
        <Setter Property="Padding"           Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="6,0,0,0"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StoreText}"/>
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StoreSubText}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Margin"     Value="0,0,0,20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         MISCELLANEOUS
    ════════════════════════════════════════════════════ -->
    <Style TargetType="StatusBar">
        <Setter Property="Background"       Value="{DynamicResource StoreSurface}"/>
        <Setter Property="Foreground"       Value="{DynamicResource StoreSubText}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="16,5"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource StoreBorder}"/>
        <Setter Property="BorderThickness"  Value="0,1,0,0"/>
    </Style>

</ResourceDictionary>
